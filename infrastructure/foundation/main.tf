# FOUNDATION layer: the long-lived parts that hold data or are hard to replace.
# Each of them has `prevent_destroy = true`, so `terraform destroy` (or any change
# that would delete and recreate them) stops with an error instead. Removing that
# line is a deliberate, visible change in Git.

resource "azurerm_resource_group" "main" {
  name     = "rg-ecom-mini"
  location = var.registry_location
  tags     = var.tags

  lifecycle {
    prevent_destroy = true
  }
}

# ---------------------------------------------------------------- cost control
# Alerts only: a budget never stops spending (see docs/azure-cost-notes.md).
# The amount is the project's hard cap (INR 5,000). Terraform only accepts whole
# percentages, and 10/20/50/80 % of 5,000 give exactly the INR 500 / 1,000 /
# 2,500 / 4,000 alerts chosen in Week 7.
locals {
  budget_alerts = {
    actual-500    = { threshold = 10, type = "Actual" }
    actual-1000   = { threshold = 20, type = "Actual" }
    actual-2500   = { threshold = 50, type = "Actual" }
    actual-4000   = { threshold = 80, type = "Actual" }
    forecast-4000 = { threshold = 80, type = "Forecasted" }
  }
}

resource "azurerm_consumption_budget_subscription" "project" {
  name            = "ecom-mini-budget"
  subscription_id = "/subscriptions/${var.subscription_id}"
  amount          = 5000 # INR (the subscription's billing currency): the project's hard cap
  time_grain      = "Annually"

  time_period {
    start_date = "2026-10-01T00:00:00Z"
    end_date   = "2027-09-30T00:00:00Z"
  }

  dynamic "notification" {
    for_each = local.budget_alerts
    content {
      enabled        = true
      operator       = "GreaterThanOrEqualTo"
      threshold      = notification.value.threshold
      threshold_type = notification.value.type
      contact_emails = [var.alert_email]
    }
  }
}

# ---------------------------------------------------------- container registry
# Holds every Docker image the app has ever run. The owner keeps it whatever happens.
resource "azurerm_container_registry" "main" {
  name                = "acrecommini${var.name_suffix}"
  resource_group_name = azurerm_resource_group.main.name
  location            = var.registry_location
  sku                 = "Standard" # the free student offer covers exactly 1 Standard registry
  admin_enabled       = false      # no registry password; the web app pulls with its managed identity
  tags                = var.tags

  lifecycle {
    prevent_destroy = true
  }
}

# ----------------------------------------------------------------- PostgreSQL
# Generated by Terraform and kept only in the (git-ignored, local) state file.
# Letters and digits only, because they are placed inside a connection URL.
resource "random_password" "postgres_admin" {
  length  = 40
  special = false
}

resource "random_password" "app_db_user" {
  length  = 32
  special = false
}

resource "azurerm_postgresql_flexible_server" "main" {
  # "-my-" because a failed India attempt reserved the plain name (Week 8).
  name                          = "psql-ecom-mini-my-${var.name_suffix}"
  resource_group_name           = azurerm_resource_group.main.name
  location                      = var.data_location
  version                       = "16"
  sku_name                      = "B_Standard_B1ms" # free: 750 h/month for 12 months
  storage_mb                    = 32768             # 32 GB, the free amount
  auto_grow_enabled             = false             # never silently grow past the free 32 GB
  backup_retention_days         = 7
  geo_redundant_backup_enabled  = false
  public_network_access_enabled = true # reachable only through the firewall rules (app layer)
  administrator_login           = "ecomadmin"
  administrator_password        = random_password.postgres_admin.result
  tags                          = var.tags

  lifecycle {
    prevent_destroy = true
    # Azure picks an availability zone at creation; changing it would mean a new server.
    ignore_changes = [zone]
  }
}

resource "azurerm_postgresql_flexible_server_database" "ecom" {
  name      = "ecom"
  server_id = azurerm_postgresql_flexible_server.main.id
  charset   = "UTF8"
  collation = "en_US.utf8"

  lifecycle {
    prevent_destroy = true
  }
}

# -------------------------------------------------------------- Blob Storage
resource "azurerm_storage_account" "images" {
  name                             = "stecommini${var.name_suffix}"
  resource_group_name              = azurerm_resource_group.main.name
  location                         = var.data_location
  account_kind                     = "StorageV2"
  account_tier                     = "Standard"
  account_replication_type         = "LRS" # free: 5 GB LRS hot
  access_tier                      = "Hot"
  https_traffic_only_enabled       = true
  min_tls_version                  = "TLS1_2"
  shared_access_key_enabled        = false # no account keys at all; Entra ID only
  allow_nested_items_to_be_public  = true  # needed for the public-read images container
  cross_tenant_replication_enabled = false
  tags                             = var.tags

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_storage_container" "product_images" {
  name                  = "product-images"
  storage_account_id    = azurerm_storage_account.images.id
  container_access_type = "blob" # anyone can read a file by its exact URL; nobody can list

  lifecycle {
    prevent_destroy = true
  }
}
