# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage

# Environment files (secrets). Only the example is committed.
.env
.env.*
!.env.example

# Terraform: never commit state (it contains generated passwords), variable files
# with real values, or provider caches. The .terraform.lock.hcl file IS committed.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
*.tfplan
crash.log

# Editor settings
.vscode/
