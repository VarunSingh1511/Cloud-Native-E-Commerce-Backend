# Files Docker never sends to the build. This keeps builds fast and makes sure
# secrets cannot end up in an image, even if a COPY is widened later.

# Secrets and local configuration
.env
.env.*

# Local environments and caches
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.coverage

# Version control and editor files
.git/
.gitignore
.vscode/

# Not needed to run the app
tests/
docs/
*.md
Dockerfile
.dockerignore
docker-compose.yml
requirements-dev.txt

# Terraform (Week 10): state can contain secrets
.terraform/
*.tfstate
*.tfstate.*
infrastructure/
