# Copy this file to .env and adjust the values. Never commit .env.
# It is read by the app (when run with uvicorn) and by Docker Compose.
ENVIRONMENT=development
# Used when running the app directly with uvicorn, against the ecom-db container
# (see README). Docker Compose ignores this and connects to its own "db" service.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecom
# Signs login tokens (JWTs). Must be at least 32 characters; the app will not
# start otherwise. Generate your own and never share it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is deliberately too short, so you cannot forget to replace it.
SECRET_KEY=change-me
# Optional: minutes a login token stays valid (default 30).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Docker Compose only ---
# Password of the PostgreSQL container that "docker compose up" creates. Local
# development only. Use letters and digits: it is placed inside a database URL.
POSTGRES_PASSWORD=postgres
# Optional: host port for the API (default 8000).
# API_PORT=8000

# --- Optional: product images in Azure Blob Storage ---
# Leave unset to disable image upload locally (the endpoint answers 503).
# When set, uploads use your `az login` session (no keys); you need the
# "Storage Blob Data Contributor" role on the container.
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=product-images
