# Copy this file to .env and adjust the values. Never commit .env.
ENVIRONMENT=development
# Local PostgreSQL running in Docker (see README). Used from Week 2.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecom
# Used for signing JWTs from Week 4. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
