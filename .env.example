# Copy this file to .env and adjust the values. Never commit .env.
ENVIRONMENT=development
# Local PostgreSQL running in Docker (see README).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ecom
# Signs login tokens (JWTs). Must be at least 32 characters; the app will not
# start otherwise. Generate your own and never share it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below is deliberately too short, so you cannot forget to replace it.
SECRET_KEY=change-me
# Optional: minutes a login token stays valid (default 30).
ACCESS_TOKEN_EXPIRE_MINUTES=30
